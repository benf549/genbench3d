# Copy to .env (which is git-ignored) and fill in. Loaded by scripts/gb3d_env.py.

# --- CCDC / CSD Python API (only for scripts/csd_extract_drug_subset.py) ---
CSDHOME=/path/to/ccdc-data
CCDC_PYTHON_API_NO_QAPPLICATION=1
# Set CCDC_LICENSING_CONFIGURATION ONLY if your host is not already activated
# (ccdc_activator -a -k <key>). Setting it can override and break an activated host.
# CCDC_LICENSING_CONFIGURATION=la-code:<your-activation-key>

# --- External references for the scorer (data that can't be committed, e.g. CSD) ---
# 'alias=dir' entries separated by ':' — then use e.g. --reference pdbbind_full+csd
# GB3D_EXTRA_REFERENCES=csd=/path/to/refdata/csd_drug
# ...or point at a JSON file of {alias: dir}:
# GB3D_REFERENCES_FILE=/path/to/references.json
